<!DOCTYPE html>
<html lang="fr">
<head>
    <meta name="monetag" content="695e0d0af1f9c9fd3bc216923a311f75">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UCL-Predictions | Command Center</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        football: {
                            primary: 'var(--fb-primary)',
                            bg: 'var(--fb-bg)',
                            surface: 'var(--fb-surface)',
                            text: 'var(--fb-text)',
                            accent: '#22C55E',
                        }
                    },
                    fontFamily: {
                        mono: ['"JetBrains Mono"', 'monospace'],
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Outfit:wght@300;400;600&family=JetBrains+Mono:wght@400;500;700&family=Fira+Code:wght@400;500&display=swap');

        :root {
            --fb-primary: #10b981;
            --fb-bg: #f8fafc;
            --fb-surface: #ffffff;
            --fb-text: #0f172a;
        }

        .dark {
            --fb-primary: #34d399;
            --fb-bg: #000000;
            --fb-surface: #0a0a0a;
            --fb-text: #f1f5f9;
        }

        body { font-family: 'Outfit', sans-serif; }
        .font-display { font-family: 'Syne', sans-serif; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }

        .pitch-lines {
            background-image: linear-gradient(to right, rgba(16, 185, 129, 0.05) 1px, transparent 1px),
                              linear-gradient(to bottom, rgba(16, 185, 129, 0.05) 1px, transparent 1px);
            background-size: 60px 60px;
        }

        .scorecard {
            background: var(--fb-surface);
            border: 1px solid rgba(16, 185, 129, 0.1);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }

        .scorecard:hover {
            border-color: var(--fb-primary);
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.1);
        }

        .floodlight-glow {
            background: radial-gradient(circle at top left, rgba(16, 185, 129, 0.05), transparent 40%),
                        radial-gradient(circle at top right, rgba(16, 185, 129, 0.05), transparent 40%);
        }
    </style>
</head>
<body class="bg-football-bg text-football-text min-h-screen flex flex-col pitch-lines floodlight-glow">

    <nav class="bg-football-bg/80 backdrop-blur-lg border-b border-football-primary/10 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center gap-8">
                    <a href="/" class="flex items-center gap-2 group">
                        <i data-lucide="trophy" class="w-6 h-6 text-football-primary"></i>
                        <span class="text-xl font-display font-bold tracking-tighter text-football-text group-hover:text-football-primary transition-colors">UCL-Predict <span class="text-football-primary">Predict</span></span>
                    </a>
                    <div class="hidden md:flex items-center gap-6">
                        <a href="/predictions" class="text-sm font-medium text-football-primary transition-colors">Prédictions</a>
                        <a href="/" class="text-sm font-medium text-football-text/60 hover:text-football-text transition-colors">Accueil</a>
                        <a href="/download" class="text-sm font-bold text-football-primary hover:opacity-80 transition-colors">Télécharger l'App</a>
                        <a href="#" class="text-sm font-medium text-football-text/60 hover:text-football-text transition-colors">Comment ça marche ?</a>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <button id="theme-toggle" class="p-2 rounded-lg bg-football-surface border border-football-primary/20 text-football-text hover:border-football-primary transition-all shadow-sm">
                        <span id="theme-toggle-icon" class="inline-flex items-center justify-center">
                            <i data-lucide="moon" class="w-4 h-4"></i>
                        </span>
                    </button>
                    <% if (user) { %>
                        <div class="flex items-center gap-3">
                            <span class="text-sm text-football-text/40 hidden sm:inline"><%= user.email %></span>
                            <% if (user.role === 'admin') { %>
                                <a href="/admin" class="px-3 py-1.5 text-xs font-bold bg-football-primary/10 text-football-primary rounded-full hover:bg-football-primary/20 transition-colors border border-football-primary/20">Admin</a>
                            <% } %>
                            <a href="/auth/logout" class="text-sm font-medium text-football-text/60 hover:text-red-500 transition-colors">Déconnexion</a>
                        </div>
                    <% } else { %>
                        <a href="/auth/login" class="text-sm font-medium text-football-text/60 hover:text-football-text transition-colors">Connexion</a>
                        <a href="/auth/register" class="px-4 py-2 text-sm font-bold text-white bg-football-primary rounded-lg hover:opacity-90 transition-all shadow-lg shadow-football-primary/20">S'inscrire</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <main class="flex-grow">
        <section class="py-8 px-4 max-w-7xl mx-auto">
            <div class="flex flex-col md:flex-row justify-between items-end mb-6 gap-6">
                <div class="space-y-2">
                    <h2 class="text-4xl font-display font-extrabold text-football-text tracking-tight">
                        Prédictions <span class="text-football-primary"><%= league %></span>
                    </h2>
                    <p class="text-football-text/60 font-medium">Terminal de données en temps réel — Moteur Adaptatif UCL-Predict</p>
                </div>
                <div class="flex flex-col sm:flex-row items-end sm:items-center gap-4">
                </div>
            </div>

            <div id="predictions-grid" class="space-y-3">
                <% predictions.forEach(p => { %>
                    <div class="scorecard rounded-xl p-3 group transition-all">
                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">

                            <!-- Match Identity -->
                            <div class="flex items-center gap-3 min-w-0">
                                <div class="w-1 h-8 bg-football-primary rounded-full"></div>
                                <h3 class="text-sm font-display font-bold text-football-text truncate group-hover:text-football-primary transition-colors">
                                    <%= p.match %>
                                </h3>
                            </div>

                            <!-- Predictions Strip -->
                            <div class="flex flex-wrap items-center gap-2 md:gap-4">
                                <div class="flex items-center gap-2 bg-football-bg/50 px-3 py-1.5 rounded-lg border border-football-primary/10">
                                    <span class="text-[9px] font-mono text-football-text/40 uppercase">1X2</span>
                                    <span class="text-sm font-bold text-football-primary"><%= p.outcomeName %></span>
                                    <div class="flex items-center gap-1.5 ml-1">
                                        <span class="text-[10px] font-mono text-football-text/40"><%= (p.outcomeConf * 100).toFixed(0) %>%</span>
                                        <div class="w-6 h-1 bg-football-bg rounded-full overflow-hidden">
                                            <div class="h-full bg-football-primary" style="width: <%= (p.outcomeConf * 100).toFixed(0) %>%"></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- BTTS -->
                                <div class="flex items-center gap-2 bg-football-bg/50 px-3 py-1.5 rounded-lg border border-football-primary/10">
                                    <span class="text-[9px] font-mono text-football-text/40 uppercase">BTTS</span>
                                    <span class="text-sm font-bold text-football-primary"><%= p.btts %></span>
                                    <div class="flex items-center gap-1.5 ml-1">
                                        <span class="text-[10px] font-mono text-football-text/40"><%= (p.bttsConf * 100).toFixed(0) %>%</span>
                                        <div class="w-6 h-1 bg-football-bg rounded-full overflow-hidden">
                                            <div class="h-full bg-football-primary" style="width: <%= (p.bttsConf * 100).toFixed(0) %>%"></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- O/U -->
                                <div class="flex items-center gap-2 bg-football-bg/50 px-3 py-1.5 rounded-lg border border-football-primary/10">
                                    <span class="text-[9px] font-mono text-football-text/40 uppercase">O/U</span>
                                    <span class="text-sm font-bold text-football-primary"><%= p.ou %></span>
                                    <div class="flex items-center gap-1.5 ml-1">
                                        <span class="text-[10px] font-mono text-football-text/40"><%= (p.ouConf * 100).toFixed(0) %>%</span>
                                        <div class="w-6 h-1 bg-football-bg rounded-full overflow-hidden">
                                            <div class="h-full bg-football-primary" style="width: <%= (p.ouConf * 100).toFixed(0) %>%"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Compact Odds -->
                            <div class="flex items-center gap-3 bg-football-bg/40 px-3 py-1.5 rounded-lg border border-football-primary/10 font-mono text-[10px]">
                                <div class="flex items-center gap-1">
                                    <span class="text-football-text/40">1:</span><span class="text-football-text font-bold"><%= p.odds.home %></span>
                                </div>
                                <div class="flex items-center gap-1 border-x border-football-primary/10 px-2">
                                    <span class="text-football-text/40">X:</span><span class="text-football-text font-bold"><%= p.odds.draw %></span>
                                </div>
                                <div class="flex items-center gap-1">
                                    <span class="text-football-text/40">2:</span><span class="text-football-text font-bold"><%= p.odds.away %></span>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>

        </section>
    </main>

    <footer class="bg-football-bg border-t border-football-primary/10 py-12 px-4">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-8">
            <div class="flex items-center gap-2">
                <i data-lucide="trophy" class="w-6 h-6 text-football-primary"></i>
                <span class="text-lg font-display font-bold text-football-text">UCL-Predict</span>
            </div>
            <p class="text-football-text/60 text-sm font-medium">
                &copy; 2026 <span class="text-football-text">UCL-Predict</span>. Gratuit et Open Source.
            </p>
            <div class="flex items-center gap-6">
                <a href="#" class="text-sm text-football-text/60 hover:text-football-primary transition-colors">Conditions</a>
                <a href="#" class="text-sm text-football-text/60 hover:text-football-primary transition-colors">Confidentialité</a>
            </div>
        </div>
    </footer>

    <!-- Floating Refresh Button -->
    <button id="refresh-btn" onclick="refreshPredictions()" class="fixed bottom-8 right-8 w-14 h-14 bg-football-primary text-white rounded-full shadow-2xl flex items-center justify-center hover:opacity-90 transition-all transform active:scale-90 z-50 group">
        <i data-lucide="refresh-cw" id="refresh-icon" class="w-6 h-6 transition-transform duration-500"></i>
        <span class="absolute right-16 bg-football-surface text-football-text text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none border border-football-primary/20">Actualiser</span>
    </button>

    <script>
        // Theme Management
        const themeToggle = document.getElementById('theme-toggle');
        const themeToggleIcon = document.getElementById('theme-toggle-icon');

        function updateTheme() {
            const isDark = document.documentElement.classList.contains('dark');
            if (themeToggleIcon) {
                themeToggleIcon.innerHTML = `<i data-lucide="${isDark ? 'sun' : 'moon'}" class="w-4 h-4"></i>`;
                lucide.createIcons();
            }
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
        }

        themeToggle.addEventListener('click', () => {
            document.documentElement.classList.toggle('dark');
            updateTheme();
        });

        // Initialize Theme
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        }
        updateTheme();

        async function refreshPredictions() {
            const btn = document.getElementById('refresh-btn');
            const icon = document.getElementById('refresh-icon');
            const grid = document.getElementById('predictions-grid');
            const statusText = document.getElementById('status-text');
            const statusDot = document.getElementById('status-dot');
            const statusPing = document.getElementById('status-ping');

            btn.disabled = true;
            icon.classList.add('animate-spin');

            // Skeleton Loader
            grid.innerHTML = Array(5).fill(0).map(() => `
                <div class="scorecard rounded-xl p-3 animate-pulse">
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="w-1 h-8 bg-football-primary/20 rounded-full"></div>
                            <div class="h-4 w-48 bg-football-bg rounded"></div>
                        </div>
                        <div class="flex flex-wrap items-center gap-2 md:gap-4">
                            <div class="h-8 w-24 bg-football-bg rounded-lg"></div>
                            <div class="h-8 w-24 bg-football-bg rounded-lg"></div>
                            <div class="h-8 w-24 bg-football-bg rounded-lg"></div>
                            <div class="h-6 w-20 bg-emerald-500/10 rounded-lg"></div>
                        </div>
                        <div class="h-8 w-32 bg-football-bg rounded-lg"></div>
                    </div>
                </div>
            `).join('');

            try {
                const response = await fetch('/predictions/api');
                if (!response.ok) throw new Error('Erreur lors de la récupération des données');

                const data = await response.json();
                const { predictions, systemState } = data;

                grid.innerHTML = predictions.map(p => `
                    <div class="scorecard rounded-xl p-3 group transition-all">
                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                            <div class="flex items-center gap-3 min-w-0">
                                <div class="w-1 h-8 bg-football-primary rounded-full"></div>
                                <h3 class="text-sm font-display font-bold text-football-text truncate group-hover:text-football-primary transition-colors">
                                    ${p.match}
                                </h3>
                            </div>
                            <div class="flex flex-wrap items-center gap-2 md:gap-4">
                                <div class="flex items-center gap-2 bg-football-bg/50 px-3 py-1.5 rounded-lg border border-football-primary/10">
                                    <span class="text-[9px] font-mono text-football-text/40 uppercase">1X2</span>
                                    <span class="text-sm font-bold text-football-primary">${p.outcomeName}</span>
                                    <div class="flex items-center gap-1.5 ml-1">
                                        <span class="text-[10px] font-mono text-football-text/40">${(p.outcomeConf * 100).toFixed(0)}%</span>
                                        <div class="w-6 h-1 bg-football-bg rounded-full overflow-hidden">
                                            <div class="h-full bg-football-primary" style="width: ${(p.outcomeConf * 100).toFixed(0)}%"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2 bg-football-bg/50 px-3 py-1.5 rounded-lg border border-football-primary/10">
                                    <span class="text-[9px] font-mono text-football-text/40 uppercase">BTTS</span>
                                    <span class="text-sm font-bold text-football-primary">${p.btts}</span>
                                    <div class="flex items-center gap-1.5 ml-1">
                                        <span class="text-[10px] font-mono text-football-text/40">${(p.bttsConf * 100).toFixed(0)}%</span>
                                        <div class="w-6 h-1 bg-football-bg rounded-full overflow-hidden">
                                            <div class="h-full bg-football-primary" style="width: ${(p.bttsConf * 100).toFixed(0)}%"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2 bg-football-bg/50 px-3 py-1.5 rounded-lg border border-football-primary/10">
                                    <span class="text-[9px] font-mono text-football-text/40 uppercase">O/U</span>
                                    <span class="text-sm font-bold text-football-primary">${p.ou}</span>
                                    <div class="flex items-center gap-1.5 ml-1">
                                        <span class="text-[10px] font-mono text-football-text/40">${(p.ouConf * 100).toFixed(0)}%</span>
                                        <div class="w-6 h-1 bg-football-bg rounded-full overflow-hidden">
                                            <div class="h-full bg-football-primary" style="width: ${(p.ouConf * 100).toFixed(0)}%"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-3 bg-football-bg/40 px-3 py-1.5 rounded-lg border border-football-primary/10 font-mono text-[10px]">
                                <div class="flex items-center gap-1">
                                    <span class="text-football-text/40">1:</span><span class="text-football-text font-bold">${p.odds.home}</span>
                                </div>
                                <div class="flex items-center gap-1 border-x border-football-primary/10 px-2">
                                    <span class="text-football-text/40">X:</span><span class="text-football-text font-bold">${p.odds.draw}</span>
                                </div>
                                <div class="flex items-center gap-1">
                                    <span class="text-football-text/40">2:</span><span class="text-football-text font-bold">${p.odds.away}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                `).join('');

                statusText.innerText = systemState;
                if (systemState === 'HEALTHY') {
                    statusText.className = 'font-bold text-emerald-400';
                    statusDot.className = 'relative inline-flex rounded-full h-2 w-2 bg-emerald-500';
                    statusPing.className = 'animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75';
                } else {
                    statusText.className = 'font-bold text-red-400';
                    statusDot.className = 'relative inline-flex rounded-full h-2 w-2 bg-red-500';
                    statusPing.className = 'animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75';
                }

            } catch (err) {
                console.error('Refresh failed:', err);
                alert('Erreur lors de l\'actualisation des prédictions. Veuillez réessayer.');
            } finally {
                btn.disabled = false;
                icon.classList.remove('animate-spin');
                grid.style.opacity = '1';
                grid.style.pointerEvents = 'auto';
            }
        }
    </script>
    <%- include('partials/chat') %>
</body>
</html>
