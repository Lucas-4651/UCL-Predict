<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VFL Predictions | Prédictions de Football par IA</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col">

    <!-- Navigation -->
    <nav class="bg-white border-b border-slate-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center gap-8">
                    <a href="/" class="flex items-center gap-2 group">
                        <span class="text-2xl">🏆</span>
                        <span class="text-xl font-bold tracking-tight text-slate-900 group-hover:text-blue-600 transition-colors">VFL <span class="text-blue-600">Predict</span></span>
                    </a>
                    <div class="hidden md:flex items-center gap-6">
                        <a href="/predictions" class="text-sm font-medium text-blue-600 transition-colors">Prédictions</a>
                        <a href="/" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors">Accueil</a>
                        <a href="/download" class="text-sm font-medium text-blue-600 hover:text-blue-700 transition-colors font-bold">Télécharger l'App</a>
                        <a href="#" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors">Comment ça marche ?</a>
                        <a href="#" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors">Tarifs (Gratuit)</a>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <% if (user) { %>
                        <div class="flex items-center gap-3">
                            <span class="text-sm text-slate-500 hidden sm:inline"><%= user.email %></span>
                            <% if (user.role === 'admin') { %>
                                <a href="/admin" class="px-3 py-1.5 text-xs font-bold bg-indigo-100 text-indigo-700 rounded-full hover:bg-indigo-200 transition-colors">Admin</a>
                            <% } %>
                            <a href="/auth/logout" class="text-sm font-medium text-slate-600 hover:text-red-600 transition-colors">Déconnexion</a>
                        </div>
                    <% } else { %>
                        <a href="/auth/login" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors">Connexion</a>
                        <a href="/auth/register" class="px-4 py-2 text-sm font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 transition-all shadow-sm">S'inscrire</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <main class="flex-grow">
        <section class="py-16 px-4 max-w-7xl mx-auto">
            <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
                <div class="space-y-2">
                    <h2 class="text-3xl font-bold text-slate-900">Prédictions <%= league %></h2>
                    <p class="text-slate-500">Données générées en temps réel par notre moteur adaptatif</p>
                </div>
                <div class="flex items-center gap-4">
                    <div class="flex items-center gap-2 px-4 py-2 rounded-lg bg-white border border-slate-200 text-xs font-semibold shadow-sm">
                        <span class="relative flex h-2 w-2">
                            <span id="status-ping" class="animate-ping absolute inline-flex h-full w-full rounded-full <%= systemState === 'HEALTHY' ? 'bg-emerald-400' : 'bg-red-400' %> opacity-75"></span>
                            <span id="status-dot" class="relative inline-flex rounded-full h-2 w-2 <%= systemState === 'HEALTHY' ? 'bg-emerald-500' : 'bg-red-500' %>"></span>
                        </span>
                        <span class="text-slate-600">Statut: </span>
                        <span id="status-text" class="<%= systemState === 'HEALTHY' ? 'text-emerald-600' : 'text-red-600' %>"><%= systemState %></span>
                    </div>
                </div>
            </div>
                </div>
            </div>

            <div id="predictions-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <% predictions.forEach(p => { %>
                    <div class="bg-white rounded-2xl p-6 border border-slate-200 hover:border-blue-300 hover:shadow-xl transition-all group">
                        <div class="flex justify-between items-start mb-6">
                            <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors leading-tight">
                                <%= p.match %>
                            </h3>
                            <span class="text-[10px] font-bold uppercase px-2 py-1 rounded bg-slate-100 text-slate-500 border border-slate-200">
                                AI Model
                            </span>
                        </div>

                        <div class="grid grid-cols-2 gap-3 mb-6">
                            <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                                <span class="text-[10px] uppercase text-slate-500 font-bold block mb-1">Pronostic 1X2</span>
                                <div class="flex items-baseline gap-2">
                                    <span class="text-2xl font-bold text-blue-600"><%= p.outcome %></span>
                                    <span class="text-xs text-slate-400"><%= (p.outcomeConf * 100).toFixed(1) %>%</span>
                                </div>
                            </div>
                            <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                                <span class="text-[10px] uppercase text-slate-500 font-bold block mb-1">BTTS</span>
                                <div class="flex items-baseline gap-2">
                                    <span class="text-2xl font-bold text-blue-600"><%= p.btts %></span>
                                    <span class="text-xs text-slate-400"><%= (p.bttsConf * 100).toFixed(1) %>%</span>
                                </div>
                            </div>
                            <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                                <span class="text-[10px] uppercase text-slate-500 font-bold block mb-1">O/U 2.5</span>
                                <div class="flex items-baseline gap-2">
                                    <span class="text-2xl font-bold text-blue-600"><%= p.ou %></span>
                                    <span class="text-xs text-slate-400"><%= (p.ouConf * 100).toFixed(1) %>%</span>
                                </div>
                            </div>
                            <div class="bg-slate-50 p-3 rounded-xl border border-slate-100 flex flex-col justify-center">
                                <span class="text-[10px] uppercase text-slate-500 font-bold block mb-1 text-center">Fiabilité</span>
                                <span class="text-xs font-medium text-blue-500 text-center">Élevée</span>
                            </div>
                        </div>

                        <div class="flex justify-between items-center bg-slate-50 p-3 rounded-xl border border-slate-100 font-mono text-xs">
                            <div class="text-center">
                                <span class="text-[10px] text-slate-400 block uppercase">Home</span>
                                <span class="text-slate-700 font-bold"><%= p.odds.home %></span>
                            </div>
                            <div class="text-center">
                                <span class="text-[10px] text-slate-400 block uppercase">Draw</span>
                                <span class="text-slate-700 font-bold"><%= p.odds.draw %></span>
                            </div>
                            <div class="text-center">
                                <span class="text-[10px] text-slate-400 block uppercase">Away</span>
                                <span class="text-slate-700 font-bold"><%= p.odds.away %></span>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </section>
    </main>

    <footer class="bg-white border-t border-slate-200 py-12 px-4">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-8">
            <div class="flex items-center gap-2">
                <span class="text-2xl">🏆</span>
                <span class="text-lg font-bold text-slate-900">VFL Predict</span>
            </div>
            <p class="text-slate-500 text-sm">
                &copy; 2026 <span class="font-semibold">VFL Autonomous Platform</span>. Gratuit et Open Source.
            </p>
            <div class="flex items-center gap-6">
                <a href="#" class="text-sm text-slate-600 hover:text-blue-600 transition-colors">Conditions</a>
                <a href="#" class="text-sm text-slate-600 hover:text-blue-600 transition-colors">Confidentialité</a>
            </div>
        </div>
    </footer>

    <!-- Floating Refresh Button -->
    <button id="refresh-btn" onclick="refreshPredictions()" class="fixed bottom-8 right-8 w-14 h-14 bg-blue-600 text-white rounded-full shadow-2xl flex items-center justify-center hover:bg-blue-700 transition-all transform active:scale-90 z-50 group" title="Actualiser les prédictions">
        <span id="refresh-icon" class="text-2xl transition-transform duration-500">🔄</span>
        <span class="absolute right-16 bg-slate-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">Actualiser</span>
    </button>

    <script>
        async function refreshPredictions() {
            const btn = document.getElementById('refresh-btn');
            const icon = document.getElementById('refresh-icon');
            const grid = document.getElementById('predictions-grid');
            const statusText = document.getElementById('status-text');
            const statusDot = document.getElementById('status-dot');
            const statusPing = document.getElementById('status-ping');

            // Start loading state
            btn.disabled = true;
            icon.classList.add('animate-spin');
            grid.style.opacity = '0.5';
            grid.style.pointerEvents = 'none';

            try {
                const response = await fetch('/predictions/api');
                if (!response.ok) throw new Error('Erreur lors de la récupération des données');

                const data = await response.json();
                const { predictions, systemState } = data;

                // Update predictions grid
                grid.innerHTML = predictions.map(p => `
                    <div class="bg-white rounded-2xl p-6 border border-slate-200 hover:border-blue-300 hover:shadow-xl transition-all group">
                        <div class="flex justify-between items-start mb-6">
                            <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors leading-tight">
                                ${p.match}
                            </h3>
                            <span class="text-[10px] font-bold uppercase px-2 py-1 rounded bg-slate-100 text-slate-500 border border-slate-200">
                                AI Model
                            </span>
                        </div>

                        <div class="grid grid-cols-2 gap-3 mb-6">
                            <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                                <span class="text-[10px] uppercase text-slate-500 font-bold block mb-1">Pronostic 1X2</span>
                                <div class="flex items-baseline gap-2">
                                    <span class="text-2xl font-bold text-blue-600">${p.outcome}</span>
                                    <span class="text-xs text-slate-400">${(p.outcomeConf * 100).toFixed(1)}%</span>
                                </div>
                            </div>
                            <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                                <span class="text-[10px] uppercase text-slate-500 font-bold block mb-1">BTTS</span>
                                <div class="flex items-baseline gap-2">
                                    <span class="text-2xl font-bold text-blue-600">${p.btts}</span>
                                    <span class="text-xs text-slate-400">${(p.bttsConf * 100).toFixed(1)}%</span>
                                </div>
                            </div>
                            <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                                <span class="text-[10px] uppercase text-slate-500 font-bold block mb-1">O/U 2.5</span>
                                <div class="flex items-baseline gap-2">
                                    <span class="text-2xl font-bold text-blue-600">${p.ou}</span>
                                    <span class="text-xs text-slate-400">${(p.ouConf * 100).toFixed(1)}%</span>
                                </div>
                            </div>
                            <div class="bg-slate-50 p-3 rounded-xl border border-slate-100 flex flex-col justify-center">
                                <span class="text-[10px] uppercase text-slate-500 font-bold block mb-1 text-center">Fiabilité</span>
                                <span class="text-xs font-medium text-blue-500 text-center">Élevée</span>
                            </div>
                        </div>

                        <div class="flex justify-between items-center bg-slate-50 p-3 rounded-xl border border-slate-100 font-mono text-xs">
                            <div class="text-center">
                                <span class="text-[10px] text-slate-400 block uppercase">Home</span>
                                <span class="text-slate-700 font-bold">${p.odds.home}</span>
                            </div>
                            <div class="text-center">
                                <span class="text-[10px] text-slate-400 block uppercase">Draw</span>
                                <span class="text-slate-700 font-bold">${p.odds.draw}</span>
                            </div>
                            <div class="text-center">
                                <span class="text-[10px] text-slate-400 block uppercase">Away</span>
                                <span class="text-slate-700 font-bold">${p.odds.away}</span>
                            </div>
                        </div>
                    </div>
                `).join('');

                // Update system status
                statusText.innerText = systemState;
                if (systemState === 'HEALTHY') {
                    statusText.className = 'text-emerald-600';
                    statusDot.className = 'relative inline-flex rounded-full h-2 w-2 bg-emerald-500';
                    statusPing.className = 'animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75';
                } else {
                    statusText.className = 'text-red-600';
                    statusDot.className = 'relative inline-flex rounded-full h-2 w-2 bg-red-500';
                    statusPing.className = 'animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75';
                }

            } catch (err) {
                console.error('Refresh failed:', err);
                alert('Erreur lors de l\'actualisation des prédictions. Veuillez réessayer.');
            } finally {
                btn.disabled = false;
                icon.classList.remove('animate-spin');
                grid.style.opacity = '1';
                grid.style.pointerEvents = 'auto';
            }
        }
    </script>
</body>
</html>
