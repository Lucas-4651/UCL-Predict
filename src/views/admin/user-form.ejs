<!DOCTYPE html>
<html lang="fr">
<head>
    <meta name="monetag" content="695e0d0af1f9c9fd3bc216923a311f75">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UCL-Predict Admin | <%= action %> Utilisateur</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        football: {
                            primary: 'var(--fb-primary)',
                            bg: 'var(--fb-bg)',
                            surface: 'var(--fb-surface)',
                            text: 'var(--fb-text)',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Outfit:wght@300;400;600&family=Fira+Code:wght@400;500&display=swap');

        :root {
            --fb-primary: #10b981;
            --fb-bg: #f8fafc;
            --fb-surface: #ffffff;
            --fb-text: #0f172a;
        }

        .dark {
            --fb-primary: #34d399;
            --fb-bg: #020617;
            --fb-surface: #0f172a;
            --fb-text: #f1f5f9;
        }

        body { font-family: 'Outfit', sans-serif; }
        .font-display { font-family: 'Syne', sans-serif; }
        .font-mono { font-family: 'Fira Code', monospace; }
    </style>
</head>
<body class="bg-football-bg text-football-text min-h-screen flex">

    <!-- Sidebar (Consistent with admin.ejs) -->
    <aside class="w-64 bg-slate-950 text-white hidden lg:flex flex-col sticky top-0 h-screen border-r border-football-primary/10">
        <div class="p-6 flex items-center gap-2">
            <span class="text-2xl">🏆</span>
            <span class="text-xl font-display font-bold tracking-tight">UCL-Predict <span class="text-football-primary">Admin</span></span>
        </div>
        <nav class="flex-grow px-4 space-y-2 mt-4">
            <a href="/admin" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white hover:bg-slate-800 rounded-xl font-medium transition-all">
                <span>📊</span> Dashboard
            </a>
            <a href="/admin/users" class="flex items-center gap-3 px-4 py-3 bg-football-primary text-white rounded-xl font-medium transition-all">
                <span>👥</span> Utilisateurs
            </a>
            <a href="/admin/learn" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white hover:bg-slate-800 rounded-xl font-medium transition-all">
                <span>🎓</span> Apprentissage IA
            </a>
            <a href="/admin/intelligence" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white hover:bg-slate-800 rounded-xl font-medium transition-all">
                <span>🧠</span> Intelligence
            </a>
        </nav>
        <div class="p-6 border-t border-slate-800">
            <a href="/" class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white transition-all text-sm font-medium">
                <span>🏠</span> Retour au site
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-grow p-4 md:p-8 overflow-y-auto">
        <header class="flex justify-between items-center mb-12">
            <div>
                <h1 class="text-3xl font-display font-bold text-football-text tracking-tight"><%= action %> Utilisateur</h1>
                <p class="text-football-text/60">Gestion des accès et des privilèges</p>
            </div>
            <div class="flex items-center gap-4">
                <button id="theme-toggle" class="p-2 rounded-lg bg-football-surface border border-football-primary/20 text-football-text hover:border-football-primary transition-all shadow-sm">
                    <span id="theme-toggle-icon" class="text-lg">🌙</span>
                </button>
                <a href="/admin/users" class="px-4 py-2 text-sm font-semibold text-football-text/60 hover:text-football-text transition-colors duration-200 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                    Retour à la liste
                </a>
            </div>
        </header>

        <div class="max-w-2xl bg-football-surface p-8 rounded-3xl border border-football-primary/10 shadow-sm">
            <form action="<%= user ? '/admin/users/update/' + user.id : '/admin/users/create' %>" method="POST" class="space-y-6">
                <div class="space-y-2">
                    <label class="text-xs font-bold uppercase text-football-text/40 tracking-wider ml-1">Email</label>
                    <input type="email" name="email" <%= user ? 'value="' + user.email + '" readonly' : 'required' %>
                        class="w-full px-4 py-3 rounded-xl bg-football-bg border border-football-primary/10 text-football-text focus:ring-2 focus:ring-football-primary outline-none transition-all duration-200 <%= user ? 'cursor-not-allowed opacity-70' : '' %>"
                        placeholder="email@exemple.com">
                </div>

                <div class="space-y-2">
                    <label class="text-xs font-bold uppercase text-football-text/40 tracking-wider ml-1">Mot de passe</label>
                    <input type="password" name="password" <%= user ? '' : 'required' %>
                        class="w-full px-4 py-3 rounded-xl bg-football-bg border border-football-primary/10 text-football-text focus:ring-2 focus:ring-football-primary outline-none transition-all duration-200"
                        placeholder="••••••••">
                    <% if (user) { %>
                        <p class="text-[10px] text-football-text/40 mt-1 ml-1">Laissez vide pour ne pas modifier le mot de passe</p>
                    <% } %>
                </div>

                <div class="space-y-2">
                    <label class="text-xs font-bold uppercase text-football-text/40 tracking-wider ml-1">Rôle</label>
                    <select name="role" class="w-full px-4 py-3 rounded-xl bg-football-bg border border-football-primary/10 text-football-text focus:ring-2 focus:ring-football-primary outline-none transition-all duration-200">
                        <option value="user" <%= (user && user.role === 'user') ? 'selected' : '' %>>Utilisateur Standard</option>
                        <option value="admin" <%= (user && user.role === 'admin') ? 'selected' : '' %>>Administrateur</option>
                    </select>
                </div>

                <div class="pt-4 flex flex-col sm:flex-row gap-3">
                    <button type="submit"
                        class="flex-grow py-3 px-4 bg-football-primary hover:opacity-90 text-white font-bold rounded-xl transition-all duration-200 shadow-lg shadow-football-primary/20 active:scale-95">
                        <%= action %> l'utilisateur
                    </button>
                    <a href="/admin/users" class="px-4 py-3 text-center text-sm font-semibold text-football-text/60 hover:text-football-text transition-colors duration-200 border border-football-primary/10 rounded-xl">
                        Annuler
                    </a>
                </div>
            </form>
        </div>
    </main>
