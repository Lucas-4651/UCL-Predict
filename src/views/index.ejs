            background: var(--fb-primary);
            transition: width 0.3s ease;
        }
        .sport-underline:hover::after { width: 100%; }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }
        .float-anim { animation: float 6s ease-in-out infinite; }
    </style>
