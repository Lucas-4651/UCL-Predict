        :root {
            --fb-primary: #10b981;
            --fb-bg: #f8fafc;
            --fb-surface: #ffffff;
            --fb-text: #0f172a;
            --fb-text-muted: #64748b;
            --fb-accent: #facc15;
        }

        .dark {
            --fb-primary: #34d399;
            --fb-bg: #020617;
            --fb-surface: #0f172a;
            --fb-text: #f1f5f9;
            --fb-text-muted: #94a3b8;
