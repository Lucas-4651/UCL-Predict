<!-- Chat Widget -->
<style>
    #chat-widget .msg-font {
        font-family: 'Segoe UI', 'Helvetica Neue', Helvetica, Arial, system-ui, sans-serif;
        font-size: 13.5px;
        line-height: 1.35;
        -webkit-font-smoothing: antialiased;
    }
</style>
<div id="chat-widget" class="fixed bottom-8 left-8 z-50 font-sans" data-current-user="<%= (typeof currentUser !== 'undefined' && currentUser && currentUser.username) ? currentUser.username : '' %>" data-current-role="<%= (typeof currentUser !== 'undefined' && currentUser && currentUser.role) ? currentUser.role : '' %>">
    <!-- Chat Bubble Button -->
    <button id="chat-toggle" class="bg-emerald-600 hover:bg-emerald-700 text-white p-4 rounded-full shadow-2xl transition-all duration-300 transform hover:scale-110 active:scale-95 flex items-center justify-center group">
        <svg id="chat-open-icon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
        </svg>
        <svg id="chat-close-icon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
        <span class="absolute -top-1 -right-1 bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full border-2 border-white hidden" id="chat-badge">!</span>
    </button>

    <!-- Chat Window -->
    <div id="chat-window" class="absolute bottom-20 left-0 w-80 md:w-96 max-h-[calc(100dvh-7rem)] flex flex-col bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-700 overflow-hidden hidden transition-all duration-300 transform translate-y-10 opacity-0">
        <!-- Header -->
        <div class="shrink-0 bg-[#0064FF] p-3.5 text-white flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 bg-white/20 rounded-full flex items-center justify-center font-bold text-lg">💬</div>
                <div>
                    <h3 class="font-bold text-sm msg-font">UCL-Predict</h3>
                    <p class="text-[10px] opacity-80 msg-font"><span id="chat-presence">1 en ligne</span></p>
                </div>
            </div>
        </div>

        <!-- Messages Area -->
        <div id="chat-messages" class="msg-font flex-1 min-h-0 overflow-y-auto p-3 space-y-2.5 bg-[#F0F2F5] dark:bg-slate-800" style="overscroll-behavior: contain;">
            <div class="text-center text-xs text-slate-400 my-4">Chargement des messages...</div>
        </div>

        <!-- Typing Indicator -->
        <div id="chat-typing" class="hidden text-xs text-slate-400 px-4 py-1 italic"></div>

        <!-- Input Area -->
        <div class="p-4 border-t border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900">
            <form id="chat-form" class="flex gap-2">
                <input type="text" id="chat-input" placeholder="Écrivez un message..."
                       class="flex-1 px-3 py-2 text-sm rounded-full border border-slate-300 dark:border-slate-600 bg-slate-100 dark:bg-slate-700 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500">
                <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white p-2 rounded-full transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
                    </svg>
                </button>
            </form>
        </div>

        <!-- Emoji Picker Menu -->
        <div id="emoji-picker" class="absolute bottom-20 left-4 w-48 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-xl hidden p-2 grid grid-cols-3 gap-2 z-50 transition-all duration-200 opacity-0 translate-y-2">
            <button data-emoji="👍" class="p-2 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg text-lg transition-colors">👍</button>
            <button data-emoji="❤️" class="p-2 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg text-lg transition-colors">❤️</button>
            <button data-emoji="😂" class="p-2 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg text-lg transition-colors">😂</button>
            <button data-emoji="😮" class="p-2 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg text-lg transition-colors">😮</button>
            <button data-emoji="😢" class="p-2 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg text-lg transition-colors">😢</button>
            <button data-emoji="😡" class="p-2 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg text-lg transition-colors">😡</button>
        </div>
    </div>
</div>

<script>
(function() {
    const toggleBtn = document.getElementById('chat-toggle');
    const windowEl = document.getElementById('chat-window');
    const openIcon = document.getElementById('chat-open-icon');
    const closeIcon = document.getElementById('chat-close-icon');
    const messagesContainer = document.getElementById('chat-messages');
    const chatForm = document.getElementById('chat-form');
    const chatInput = document.getElementById('chat-input');
    const chatBadge = document.getElementById('chat-badge');
    const emojiPicker = document.getElementById('emoji-picker');

    let lastMessageId = null;
    let activeMessageId = null;

    // Escape user-provided content before injecting into innerHTML (prevents XSS).
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[c]));

    // Deterministic avatar color from a name (stable across renders, no storage needed).
    const AVATAR_COLORS = ['bg-rose-500', 'bg-orange-500', 'bg-amber-500', 'bg-emerald-500', 'bg-teal-500', 'bg-sky-500', 'bg-indigo-500', 'bg-violet-500', 'bg-fuchsia-500'];
    const avatarColor = (name) => {
        let h = 0;
        for (let i = 0; i < name.length; i++) h = (h * 31 + name.charCodeAt(i)) >>> 0;
        return AVATAR_COLORS[h % AVATAR_COLORS.length];
    };
    const initial = (name) => (name || '?').trim().charAt(0).toUpperCase();

    const fmtTime = (ts) => {
        const d = ts ? new Date(ts) : null;
        return d && !isNaN(d) ? d.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) : '';
    };

    // Toggle Window
    toggleBtn.addEventListener('click', () => {
        const isHidden = windowEl.classList.contains('hidden');
        if (isHidden) {
            windowEl.classList.remove('hidden');
            document.body.style.overflow = 'hidden'; // lock background scroll
            setTimeout(() => {
                windowEl.classList.remove('translate-y-10', 'opacity-0');
            }, 10);
            openIcon.classList.add('hidden');
            closeIcon.classList.remove('hidden');
            chatBadge.classList.add('hidden');
        } else {
            windowEl.classList.add('translate-y-10', 'opacity-0');
            document.body.style.overflow = ''; // restore background scroll
            setTimeout(() => windowEl.classList.add('hidden'), 300);
            openIcon.classList.remove('hidden');
            closeIcon.classList.add('hidden');
        }
    });

    // Emoji Picker Logic
    window.toggleReactionMenu = (messageId) => {
        activeMessageId = messageId;
        emojiPicker.classList.remove('hidden');
        setTimeout(() => {
            emojiPicker.classList.remove('opacity-0', 'translate-y-2');
        }, 10);
    };

    const hideEmojiPicker = () => {
        emojiPicker.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => emojiPicker.classList.add('hidden'), 200);
        activeMessageId = null;
    };

    document.addEventListener('click', (e) => {
        if (!emojiPicker.contains(e.target) && !e.target.closest('[onclick^="window.toggleReaction"]')) {
            hideEmojiPicker();
        }
    });

    emojiPicker.addEventListener('click', async (e) => {
        const btn = e.target.closest('button');
        if (!btn) return;

        const emoji = btn.dataset.emoji;
        if (activeMessageId) {
            await window.toggleReaction(activeMessageId, emoji);
            hideEmojiPicker();
        }
    });

    window.toggleReaction = async (messageId, emoji) => {
        if (!emoji) {
            window.toggleReactionMenu(messageId);
            return;
        }

        try {
            const res = await fetch('/api/chat/react', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ messageId, reaction: emoji })
            });
            if (!res.ok) throw new Error('Erreur lors de la réaction');
            await fetchMessages();
        } catch (err) {
            console.error('Reaction error:', err);
        }
    };

    async function fetchMessages() {

        try {
            const res = await fetch('/api/chat/messages');
            const messages = await res.json();

            if (messages.length === 0) {
                messagesContainer.innerHTML = '<div class="text-center text-xs text-slate-400 my-4">Aucun message pour le moment.</div>';
                return;
            }

            // Check for new messages to show badge
            if (lastMessageId && messages[messages.length - 1].id !== lastMessageId) {
                chatBadge.classList.remove('hidden');
            }
            lastMessageId = messages[messages.length - 1].id;

            const me = windowEl.closest('#chat-widget').dataset.currentUser;
            messagesContainer.innerHTML = messages.map(m => {
                const isBroadcast = m.type === 'broadcast';
                const isPinned = m.is_pinned;
                const isAdminMsg = m.is_admin || (m.user_role === 'admin');
                const author = esc(m.username || m.user_name || 'Utilisateur');
                const mine = !isBroadcast && !isAdminMsg && author && me && author.toLowerCase() === me.toLowerCase();
                const reactions = m.reactions || {};
                const reactionHtml = Object.entries(reactions)
                    .map(([emoji, count]) =>
                        `<button onclick="window.toggleReaction(${m.id}, '${emoji}')" title="Retirer ma réaction" class="flex items-center gap-1 bg-slate-200 dark:bg-slate-700 hover:bg-blue-200 dark:hover:bg-blue-800 px-1.5 py-0.5 rounded-full text-[10px] font-medium transition-colors">${emoji} ${count}</button>`)
                    .join('');

                // Messenger avatar bubble (initial + deterministic color)
                const avatar = (isBroadcast || isAdminMsg) ? '' :
                    `<div class="shrink-0 w-7 h-7 rounded-full ${avatarColor(author)} text-white flex items-center justify-center text-[11px] font-bold self-end mb-0.5">${esc(initial(author))}</div>`;

                // ADMIN messages are always centered (broadcast or not), Messenger-style callout.
                if (isAdminMsg) {
                    return `
                        <div class="flex justify-center group relative w-full">
                            <div class="max-w-[90%] px-3.5 py-2 rounded-2xl text-center shadow-sm bg-[#E7F3FF] dark:bg-blue-900/40 border border-[#BBD7FB] dark:border-blue-700 text-slate-800 dark:text-slate-100">
                                ${isPinned ? '<div class="text-[9px] font-bold uppercase tracking-wider text-blue-500 mb-0.5">📌 Épinglé</div>' : ''}
                                <div class="font-bold text-[11px] mb-0.5 text-[#0064FF] dark:text-blue-300">👑 ${author}</div>
                                <p class="leading-relaxed break-words">${esc(m.content)}</p>
                                <div class="text-[9px] mt-1 text-slate-400">${fmtTime(m.created_at)}</div>
                            </div>
                        </div>`;
                }

                const bubble = `
                    <div class="max-w-[80%] px-3.5 py-2 rounded-2xl shadow-sm ${
                        isBroadcast
                        ? 'bg-amber-50 dark:bg-amber-900/30 border border-amber-200 dark:border-amber-800 text-amber-900 dark:text-amber-100 rounded-lg text-center italic'
                        : (mine
                            ? 'bg-[#0064FF] text-white rounded-br-md'
                            : 'bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 rounded-bl-md border border-slate-100 dark:border-slate-600')
                    }">
                        ${!isBroadcast && !mine ? `<div class="font-bold text-[11px] mb-0.5 text-[#0064FF] dark:text-blue-300">${author}</div>` : ''}
                        <p class="leading-relaxed break-words">${esc(m.content)}</p>
                        <div class="text-[9px] mt-1 ${mine ? 'text-blue-100/90' : 'text-slate-400'} ${isBroadcast ? 'text-center' : 'text-right'}">${fmtTime(m.created_at)}</div>
                    </div>`;

                return `
                    <div class="flex items-end gap-2 ${isBroadcast ? 'justify-center' : (mine ? 'flex-row-reverse' : 'flex-row')} group relative">
                        ${avatar}
                        <div class="flex flex-col ${mine ? 'items-end' : 'items-start'} max-w-full">
                            ${bubble}
                            <div class="flex flex-wrap gap-1 mt-1 px-1 ${isBroadcast ? 'justify-center w-full' : ''}">
                                ${reactionHtml}
                                <button onclick="window.toggleReaction(${m.id}, null)" class="text-[10px] bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-400 hover:bg-[#0064FF] hover:text-white opacity-0 group-hover:opacity-100 transition-all px-2 py-0.5 rounded-full font-medium flex items-center gap-1">
                                    <span>😊</span> <span>Réagir</span>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');

            // Scroll to bottom only if user is already near the bottom
            if (!windowEl.classList.contains('hidden')) {
                const isNearBottom = messagesContainer.scrollHeight - messagesContainer.scrollTop <= messagesContainer.clientHeight + 150;
                if (isNearBottom) {
                    messagesContainer.scrollTop = messagesContainer.scrollHeight;
                }
            }
        } catch (err) {
            console.error('Chat fetch error:', err);
        }
    }

    chatForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const content = chatInput.value.trim();
        if (!content) return;

        chatInput.value = '';
        try {
            const res = await fetch('/api/chat/send', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ content })
            });
            if (!res.ok) {
                const data = await res.json();
                alert(data.error || 'Erreur lors de l\'envoi');
            } else {
                await fetchMessages();
            }
        } catch (err) {
            alert('Erreur réseau lors de l\'envoi');
        }
    });

    // ---- Real-time: EventSource instead of polling ----
    const presenceEl = document.getElementById('chat-presence');
    const typingEl = document.getElementById('chat-typing');

    let esFailCount = 0;
    let pollingFallback = null;
    let suppressSound = false;          // cleared after our own optimistic render
    let selfTypingUntil = 0;            // heuristic window to ignore our own "typing"
    let lastTyping = 0;                 // throttles our own typing emit

    // Sound: WebAudio beep (no binary asset needed), lazily created on first user gesture.
    let audioCtx = null;
    function playNotify() {
        try {
            audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
            const o = audioCtx.createOscillator();
            o.connect(audioCtx.destination);
            o.frequency.value = 660;
            o.start();
            setTimeout(() => o.stop(), 120);
        } catch (e) { /* ignore */ }
    }

    function showTyping(username) {
        if (!typingEl) return;
        const name = username || 'Quelqu\'un';
        typingEl.textContent = `${name} écrit…`;
        typingEl.classList.remove('hidden');
        clearTimeout(showTyping._t);
        showTyping._t = setTimeout(() => typingEl.classList.add('hidden'), 3000);
    }

    function notifyIfHidden() {
        if (windowEl.classList.contains('hidden')) {
            chatBadge.classList.remove('hidden');
            playNotify();
        }
    }

    function handleEvent(data) {
        switch (data.type) {
            case 'init':
            case 'message':
            case 'reaction':
                // Reuse the existing rich rendering (broadcast / pinned / reactions).
                fetchMessages();
                if (data.type === 'message') {
                    if (suppressSound) { suppressSound = false; }
                    else { notifyIfHidden(); }
                }
                break;
            case 'presence':
                if (presenceEl) {
                    presenceEl.textContent = `${data.count} en ligne`;
                }
                break;
            case 'typing':
                if (Date.now() > selfTypingUntil && data.username) {
                    showTyping(data.username);
                }
                break;
            case 'ping':
            default:
                break;
        }
    }

    function setupSSE() {
        if (pollingFallback) return; // already降级到轮询
        const es = new EventSource('/api/chat/stream');
        es.onmessage = (e) => {
            esFailCount = 0;
            try { handleEvent(JSON.parse(e.data)); } catch (err) { /* ignore malformed */ }
        };
        es.onerror = () => {
            es.close();
            esFailCount++;
            if (esFailCount >= 5 && !pollingFallback) {
                // Graceful degradation: fall back to the old 4s poll.
                pollingFallback = setInterval(fetchMessages, 4000);
                if (presenceEl) presenceEl.textContent = 'Reconnexion…';
            }
        };
    }

    // Throttled typing indicator (emit at most every 1.5s).
    if (chatInput) {
        chatInput.addEventListener('input', () => {
            const now = Date.now();
            if (now - lastTyping > 1500) {
                lastTyping = now;
                selfTypingUntil = now + 2000; // suppress our own echo
                fetch('/api/chat/typing', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({})
                }).catch(() => {});
            }
        });
    }

    // Optimistically suppress the sound on our own send (we'll get the SSE echo).
    chatForm.addEventListener('submit', () => { suppressSound = true; }, true);

    fetchMessages().then(setupSSE);
})();
</script>
